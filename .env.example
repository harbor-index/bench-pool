# Copy to .env and fill in. .env is git-ignored.
# On GitHub, add the same names under Settings > Secrets and variables > Actions.

# Language model: any OpenAI-compatible endpoint
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional. Needed for models that reason at length before answering (e.g. deepseek): 24000
OPENAI_MAX_TOKENS=
# Optional. "off" asks a reasoning model to skip its long reasoning (faster, cheaper)
OPENAI_THINKING=

# Signals
GITHUB_TOKEN=
HF_TOKEN=
S2_API_KEY=
